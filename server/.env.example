PORT=5050
JWT_SECRET=change-this-to-a-long-random-string

# Set to true on hosted demos to recreate the demo account on every start.
SEED_DEMO=false

# Optional: sending invoice emails. Leave all empty to use a free Ethereal test inbox
# (a preview link is shown after sending).
#
# Option A — Brevo HTTPS API (free 300/day; works on hosts that block SMTP, like Railway).
# SMTP_FROM must be a sender address verified in your Brevo account.
BREVO_API_KEY=
#
# Option B — your own SMTP server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
